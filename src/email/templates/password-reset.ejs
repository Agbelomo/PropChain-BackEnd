<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #333;"><%= t.password_reset_title %></h2>
  <p><%= t.password_reset_body %></p>
  <p><%= t.password_reset_cta %>:</p>
  <a href="<%= resetUrl %>" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px; margin: 20px 0;">
    <%= t.password_reset_cta %>
  </a>
  <p><%= t.password_reset_ignore %></p>
  <p><%= t.password_reset_expiry %></p>
  <p><%= t.regards %><br><%= t.team %></p>
</div>
